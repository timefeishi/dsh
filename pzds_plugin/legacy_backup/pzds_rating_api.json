{"code":0, "message":"", "data":{"title":"原神限定UP角色_深境评分", "appId":"aiCoding", "userId":"2ea47f19f840468ba8d8f0c9ed490e23", "lang":"html", "agentId":"", "msgTraceId":"", "msgModelId":"", "conversationId":"0P64k8CzlGG", "shareDesc":"", "shareId":"canvas-a04009f94c19557d5073b9e01b4f2df8", "cardId":"", "version":"", "scene":"aiCoding", "jumpUrl":"", "jumpDesc":"去元宝做同款", "jumpScene":3, "code":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>原神限定UP五星角色 · 深境螺旋12层评分（≥8.0）</title>\n<style>\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:\"WenQuanYi Micro Hei\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;\n    background:#0f1115;color:#e0e0e0;padding:20px;font-size:14px;line-height:1.6}\n  .wrap{max-width:1000px;margin:0 auto}\n  h1{font-size:22px;text-align:center;margin-bottom:6px;color:#fff}\n  .sub{text-align:center;color:#888;font-size:13px;margin-bottom:16px}\n  .stats{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}\n  .stat{flex:1;min-width:100px;max-width:140px;background:#1a1d24;border:1px solid #2a2e38;border-radius:8px;padding:10px;text-align:center}\n  .stat .n{font-size:26px;font-weight:700}\n  .stat .l{font-size:12px;color:#999;margin-top:2px}\n  .stat.t0 .n{color:#f5b301}.stat.t1 .n{color:#2196f3}.stat.t2 .n{color:#ff7043}\n  table{border-collapse:collapse;width:100%;background:#16191f;border-radius:10px;overflow:hidden;font-size:13px}\n  th,td{padding:8px 10px;text-align:center;border-bottom:1px solid #232834}\n  th{background:#1e222b;color:#bbb;font-weight:600;position:sticky;top:0}\n  tr:last-child td{border-bottom:none}\n  tbody tr:hover{background:#1c2029}\n  td.rank{color:#666;font-weight:700;width:36px}\n  td.score{font-weight:700;font-size:15px;width:50px}\n  td.s9{color:#f5b301}.td8{color:#2196f3}\n  .bar{height:7px;border-radius:4px;background:#2a2e38;overflow:hidden;display:inline-block;width:100px;vertical-align:middle}\n  .bar i{display:block;height:100%;border-radius:4px}\n  .badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:12px;font-weight:700}\n  .b-t0{background:#f5b301;color:#000}.b-t1{background:#2196f3;color:#fff}.b-t2{background:#ff7043;color:#fff}\n  .dot{display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle;margin-right:3px}\n  .el-water{background:#4fc3f7}.el-fire{background:#ff7043}.el-wind{background:#81c784}\n  .el-lightning{background:#ffd54f}.el-geo{background:#b39ddb}.el-ice{background:#90caf9}\n  .el-physic{background:#9e9e9e}\n  .note{margin-top:16px;color:#888;font-size:12px;line-height:1.9}\n  .note b{color:#aaa}\n  .filter{text-align:center;margin-bottom:12px}\n  .filter button{background:#1a1d24;border:1px solid #2a2e38;color:#ccc;padding:5px 12px;border-radius:16px;cursor:pointer;font-size:12px;margin:0 3px}\n  .filter button.active{background:#2e7d32;border-color:#2e7d32;color:#fff}\n  .filter button:hover{border-color:#555}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <h1>⭐ 原神限定UP五星角色 · 深境螺旋12层评分</h1>\n  <div class=\"sub\">纯深渊向 · 仅含限定五星（无四星/常驻）· 评分降序 → 同分按登场版本时间升序</div>\n\n  <div class=\"stats\" id=\"stats\"></div>\n\n  <div class=\"filter\" id=\"filter\">\n    <button class=\"active\" onclick=\"setFilter('all',this)\">全部</button>\n    <button onclick=\"setFilter('water',this)\">水</button>\n    <button onclick=\"setFilter('fire',this)\">火</button>\n    <button onclick=\"setFilter('wind',this)\">风</button>\n    <button onclick=\"setFilter('lightning',this)\">雷</button>\n    <button onclick=\"setFilter('geo',this)\">岩</button>\n    <button onclick=\"setFilter('ice',this)\">冰</button>\n    <button onclick=\"setFilter('physic',this)\">物理</button>\n  </div>\n\n  <table>\n    <thead><tr>\n      <th>#</th><th>评分</th><th>评分条</th><th>角色</th><th>元素</th>\n      <th>定位</th><th>登场版本</th><th>历史定位一句话</th><th>评级</th>\n    </tr></thead>\n    <tbody id=\"tbody\"></tbody>\n  </table>\n\n  <div class=\"note\">\n    <b>评分维度：</b>仅评估深境螺旋12层表现（对单/对群DPS、输出真空期、生存压力、配队自由度、减抗增伤覆盖率、能否独立撑起一层）。<b>大世界探索、跑图、剧情向能力一律不计分</b>。<br>\n    <b>版本基准：</b>6.6–6.7 深渊环境，星超导（+75%）、月感电（+75%）获版本定向BUFF，蒸发/融化/永冻/感电/绽放为旧体系。<br>\n    <b>评级：</b>T0=9.0–9.5（满星即战力）· T1=8.0–8.5（需正确配队）· 本表仅展示 ≥8.0 角色。<br>\n    <b>说明：</b>评分反映当前深渊环境，不代表角色\"强弱\"——如优菈物理被环境抛弃仅反映现状，不否定当年T1地位；那维莱特、芙宁娜、玛薇卡等跨环境执法角色仍稳居T0。\n  </div>\n</div>\n\n<script>\nvar DATA = [\n[\"那维莱特\",\"water\",\"4.1\",\"主C\",9.5,\"枫丹数值膨胀顶点，重做主C范式，0命单通标杆\"],\n[\"玛薇卡\",\"fire\",\"5.3\",\"主C\",9.5,\"纳塔神明，数值+机动双破格，火系当前顶点\"],\n[\"芙宁娜\",\"water\",\"4.2\",\"全队增伤辅助\",9.5,\"枫丹神权顶点，增伤范式重写，人权级辅助\"],\n[\"尼可\",\"fire\",\"6.6\",\"全能辅助\",9.5,\"魔女会体系核心，星超导扶持下复出的版本之星\"],\n[\"桑多涅\",\"ice\",\"6.7\",\"星超导核心转化\",9.5,\"星超导BUFF最大受益者，深渊上半场核心\"],\n[\"阿蕾奇诺\",\"fire\",\"4.7\",\"主C\",9.0,\"枫丹结局人权C，一人成军，机制自闭环\"],\n[\"希诺宁\",\"geo\",\"5.1\",\"减抗/治疗/夜魂辅助\",9.0,\"纳塔版万叶+钟离合体，当前最强通用辅之一\"],\n[\"茜特菈莉\",\"ice\",\"5.3\",\"护盾/减抗/冰火专拐\",9.0,\"纳塔奶奶，冰火双修人权辅，盘活冰系\"],\n[\"杜林\",\"fire\",\"6.3\",\"魔主C/辅助\",9.0,\"魔导体系重启者，老角色加强引擎\"],\n[\"丝柯克\",\"ice\",\"5.7\",\"融化队主C\",9.0,\"达达利亚师父，跨体系实验，纳塔流水王\"],\n[\"伊涅芙\",\"lightning\",\"5.8\",\"月感电体系核心\",9.0,\"开启月反应新纪元，空月之歌轴心\"],\n[\"菈乌玛\",\"geo\",\"6.0\",\"月绽放核心辅助\",9.0,\"挪德卡莱开篇，月绽放运钞车/大脑\"],\n[\"哥伦比娅\",\"water\",\"6.7\",\"月反应主C\",9.0,\"月兆+月绽放复合体系核心\"],\n[\"兹白\",\"geo\",\"6.2\",\"月结晶站场主C\",9.0,\"月结晶体系站场核心，纳塔新元素玩法\"],\n[\"法尔伽\",\"wind\",\"6.4\",\"魔主C\",9.0,\"魔女会体系副轴，风系新主C\"],\n[\"爱可菲\",\"ice\",\"5.6\",\"冰副C/治疗\",9.0,\"冰系长期弱势终结者，盘活冰系\"],\n[\"菲林斯\",\"lightning\",\"6.1\",\"月感电站场主C\",9.0,\"人气成男，月感电轴主战力\"],\n[\"洛恩\",\"ice\",\"6.6\",\"站场主C\",8.5,\"策谋状态机制，6.6新角色强势站场\"],\n[\"莉奈娅\",\"geo\",\"6.5\",\"月结晶队拼图\",8.5,\"月结晶体系核心拼图，纳塔后半核心\"],\n[\"八重神子\",\"lightning\",\"2.5\",\"脱手副C\",8.5,\"钟离事件2.0，杀生樱体系复出\"],\n[\"雷电将军\",\"lightning\",\"2.1\",\"充能轴主C\",8.5,\"稻妻神权顶点，充能轴革命，雷国核心\"],\n[\"克洛琳德\",\"lightning\",\"4.7\",\"超激化主C\",8.5,\"枫丹刻晴升级版，激化/超载双修\"],\n[\"娜维娅\",\"geo\",\"4.3\",\"速切爆发主C\",8.5,\"岩系破局者，不锁队自由输出\"],\n[\"恰斯卡\",\"wind\",\"5.2\",\"空中弹幕主C\",8.5,\"风系主C机制革新，空中锁弹必中\"],\n[\"瓦雷莎\",\"lightning\",\"5.5\",\"冲跑下落主C\",8.5,\"纳塔机动派雷C，伊安珊师徒组\"],\n[\"莱欧斯利\",\"ice\",\"4.1\",\"近战重击主C\",8.5,\"监狱长，近战冰C手感派，融甘可用\"],\n[\"艾尔海森\",\"geo\",\"3.4\",\"激化主C\",8.5,\"草系直伤范式，黎明神剑战神\"],\n[\"胡桃\",\"fire\",\"1.3\",\"蒸发主C\",8.5,\"反应主C设计范本，火C天花板多年\"],\n[\"玛拉妮\",\"water\",\"5.0\",\"冲浪主C\",8.5,\"纳塔夜魂机动开幕，水系机动派\"],\n[\"钟离\",\"geo\",\"1.1\",\"护盾/减抗\",8.0,\"钟离事件倒逼重做，护盾范式奠基者\"],\n[\"枫原万叶\",\"wind\",\"2.0\",\"聚怪/增伤\",8.0,\"聚怪2.0取代温迪，风系辅助新范式\"],\n[\"纳西妲\",\"geo\",\"3.2\",\"反应核心\",8.0,\"草元素体系奠基者，小吉祥草王\"],\n[\"夜兰\",\"water\",\"2.7\",\"后台副C\",8.0,\"行秋上位+大世界神，泛用天花板\"],\n[\"阿贝多\",\"geo\",\"1.2\",\"后台副C\",8.0,\"岩队拼图，机制独特吃环境\"],\n[\"神里绫华\",\"ice\",\"2.0\",\"永冻主C\",8.0,\"稻妻门面，永冻时代符号，对单顶级\"],\n[\"珊瑚宫心海\",\"water\",\"2.1\",\"治疗/挂水\",8.0,\"稳定挂水奶，永冻/感电拼图\"],\n[\"申鹤\",\"ice\",\"2.4\",\"冰系专辅/增伤\",8.0,\"冰系专拐开端，泛用性争议\"],\n[\"神里绫人\",\"water\",\"2.6\",\"站场主C\",8.0,\"水系站场优雅派，永冻/感电可用\"],\n[\"妮露\",\"water\",\"3.1\",\"绽放专核\",8.0,\"把绽放从杂技变成体系\"],\n[\"白术\",\"geo\",\"3.6\",\"治疗/挂草\",8.0,\"首个草系多功能奶，UI级舒适\"],\n[\"千织\",\"geo\",\"4.5\",\"后台副C\",8.0,\"枫丹岩系补强，岩协同机制\"],\n[\"基尼奇\",\"geo\",\"5.0\",\"燃草主C\",8.0,\"钩索机动+燃草实验，纳塔草系\"],\n[\"奈芙尔\",\"geo\",\"6.2\",\"月绽放站场主C\",8.0,\"月绽放运钞车二号机，极限伤害向\"]\n];\n\n// 排名：评分降序 → 同分按ver时间升序\nDATA.sort(function(a,b){return b[4]-a[4] || (a[2]>b[2]?1:a[2]<b[2]?-1:0);});\n\nvar EL_CN={water:\"水\",fire:\"火\",wind:\"风\",lightning:\"雷\",geo:\"岩\",ice:\"冰\",physic:\"物理\"};\nvar RATE=function(s){return s>=9?\"T0\":s>=8?\"T1\":\"T2\"};\nvar RB=function(s){return s>=9?\"b-t0\":s>=8?\"b-t1\":\"b-t2\"};\nvar BAR_C=function(s){return s>=9?\"#f5b301\":s>=8?\"#2196f3\":\"#ff7043\"};\nvar DOT_C=function(e){return {water:\"#4fc3f7\",fire:\"#ff7043\",wind:\"#81c784\",lightning:\"#ffd54f\",geo:\"#b39ddb\",ice:\"#90caf9\",physic:\"#9e9e9e\"}[e]||\"#999\";};\n\n// 统计\nvar cnt={t0:0,t1:0,t2:0};\nDATA.forEach(function(d){var r=RATE(d[4]);cnt[r]++;});\ndocument.getElementById('stats').innerHTML=\n'<div class=\"stat t0\"><div class=\"n\">'+cnt.t0+'</div><div class=\"l\">T0（9.0-9.5）</div></div>'+\n'<div class=\"stat t1\"><div class=\"n\">'+cnt.t1+'</div><div class=\"l\">T1（8.0-8.5）</div></div>'+\n'<div class=\"stat\" style=\"border-color:#333\"><div class=\"n\" style=\"color:#fff\">'+DATA.length+'</div><div class=\"l\">限定五星（≥8.0）</div></div>';\n\nvar curEl='all';\nfunction setFilter(el,btn){\n  curEl=el;\n  document.querySelectorAll('.filter button').forEach(function(b){b.classList.remove('active');});\n  btn.classList.add('active');\n  draw();\n}\nfunction draw(){\n  var rows=DATA.filter(function(d){return curEl==='all'||d[1]===curEl;});\n  var html='';\n  rows.forEach(function(d,i){\n    var sc=d[4]>=9?'td8':'';\n    var barC=BAR_C(d[4]);\n    html+='<tr>'+\n    '<td class=\"rank\">'+(i+1)+'</td>'+\n    '<td class=\"score '+sc+'\">'+d[4].toFixed(1)+'</td>'+\n    '<td><div class=\"bar\"><i style=\"width:'+(d[4]/10*100)+'%;background:'+barC+'\"></i></div></td>'+\n    '<td><b>'+d[0]+'</b></td>'+\n    '<td><span class=\"dot\" style=\"background:'+DOT_C(d[1])+'\"></span>'+EL_CN[d[1]]+'</td>'+\n    '<td style=\"text-align:left;color:#ccc\">'+d[3]+'</td>'+\n    '<td>'+d[2]+'</td>'+\n    '<td style=\"text-align:left;color:#999;font-size:12px\">'+d[5]+'</td>'+\n    '<td><span class=\"badge '+RB(d[4])+'\">'+RATE(d[4])+'</span></td>'+\n    '</tr>';\n  });\n  document.getElementById('tbody').innerHTML=html;\n}\ndraw();\n</script>\n</body>\n</html>\n", "msgIds":["0P64k8CzlGG_18"]}, "appId":""}